<view class="page">
  <view wx:if="{{loading}}" class="card muted">正在读取…</view>
  <block wx:else>
    <view class="card" wx:if="{{plant}}">
      <view class="title">{{plant.name}}</view><view class="muted">已确认学名：{{plant.species || '尚未确认'}}</view>
      <picker mode="selector" range="{{petPreferences}}" value="{{petPreferenceIndex}}" bindchange="setPetPreference"><view class="field">宠物关注：{{petPreferences[petPreferenceIndex]}}　›</view></picker>
      <view class="pet-detail"><view>猫：{{plant.petSummary.cat === 'toxic' ? '有毒性记录' : plant.petSummary.cat === 'non_toxic' ? '资料列为无毒' : '资料未确认'}}</view><view>狗：{{plant.petSummary.dog === 'toxic' ? '有毒性记录' : plant.petSummary.dog === 'non_toxic' ? '资料列为无毒' : '资料未确认'}}</view></view>
      <view wx:if="{{plant.petNote}}" class="muted">公共资料说明：{{plant.petNote}}</view><view wx:if="{{plant.petSource}}" class="muted" selectable="true">来源：{{plant.petSource}}</view><button wx:if="{{plant.petSource}}" class="small-button" bindtap="copySource">复制来源链接</button>
    </view>
    <view class="card"><view class="plant-name">首批已核对物种</view><view class="muted">只有确认学名后才会关联标签；未知植物保持“资料未确认”。</view><view class="species-actions"><button class="small-button" data-species="Epipremnum aureum" bindtap="confirmCommonSpecies">绿萝</button><button class="small-button" data-species="Chlorophytum comosum" bindtap="confirmCommonSpecies">吊兰</button><button class="small-button" data-species="Chamaedorea elegans" bindtap="confirmCommonSpecies">袖珍椰子</button><button class="small-button" data-species="Lilium lancifolium" bindtap="confirmCommonSpecies">卷丹</button></view></view>
    <view class="card"><view class="plant-name">生长相册</view><picker mode="date" value="{{photoDate}}" bindchange="onPhotoDateChange"><view class="field">拍摄日期：{{photoDate}}　›</view></picker><input class="field" placeholder="照片备注（可选）" value="{{photoNote}}" bindinput="onPhotoNoteInput" maxlength="200" /><button class="small-button" bindtap="addPhoto">添加照片</button><view wx:if="{{comparePhotos.length === 2}}" class="photo-grid"><view wx:for="{{comparePhotos}}" wx:key="_id"><image class="photo" mode="aspectFill" src="{{item.fileId}}" /><view class="muted">对比：{{item.occurredAt}}</view></view></view><view class="photo-grid"><view wx:for="{{photos}}" wx:key="_id"><image class="photo" mode="aspectFill" src="{{item.fileId}}" bindtap="toggleCompare" data-id="{{item._id}}" /><view class="muted">{{item.occurredAt}}　点图加入对比</view><view wx:if="{{item.note}}" class="muted">{{item.note}}</view><button class="text-button" data-id="{{item._id}}" bindtap="deletePhoto">删除照片</button></view></view></view>
    <view class="card"><view class="plant-name">{{editingEventId ? '更正养护记录' : '直接记录养护'}}</view><picker mode="selector" range="{{eventKinds}}" value="{{eventKindIndex}}" bindchange="onEventKindChange"><view class="field">类型：{{eventKinds[eventKindIndex]}}　›</view></picker><picker wx:if="{{!editingEventId}}" mode="selector" range="{{taskNames}}" value="{{selectedTaskIndex}}" bindchange="onTaskChange"><view class="field">同时完成待办：{{taskNames[selectedTaskIndex]}}　›</view></picker><picker wx:if="{{eventKindIndex === 2}}" mode="selector" range="{{observationStatuses}}" value="{{observationStatusIndex}}" bindchange="onObservationStatusChange"><view class="field">土壤状态：{{observationStatuses[observationStatusIndex]}}　›</view></picker><picker mode="date" value="{{occurredDate}}" bindchange="onOccurredDateChange"><view class="field">实际日期：{{occurredDate}}　›</view></picker><picker mode="time" value="{{occurredTime}}" bindchange="onOccurredTimeChange"><view class="field">实际时间：{{occurredTime}}　›</view></picker><input class="field" placeholder="备注（可选）" value="{{note}}" bindinput="onNoteInput" maxlength="200" /><input class="field" type="digit" placeholder="用量（可选）" value="{{amount}}" bindinput="onAmountInput" /><input class="field" placeholder="单位，例如毫升或克" value="{{amountUnit}}" bindinput="onUnitInput" maxlength="20" /><button class="button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveEvent">保存记录</button></view>
    <view class="card"><view class="plant-name">养护历史</view><picker mode="selector" range="{{filterLabels}}" bindchange="onFilterChange"><view class="field">筛选：{{filter === 'all' ? '全部' : filter}}　›</view></picker><view wx:if="{{!visibleEvents.length}}" class="muted">暂无符合条件的记录。</view><view wx:for="{{visibleEvents}}" wx:key="_id" class="task-card"><view class="plant-name">{{item.kind === 'water' ? '浇水' : item.kind === 'fertilize' ? '施肥' : item.kind === 'check' ? '检查' : item.kind === 'observation' ? '观察' : '记录'}}</view><view class="task-date">{{item.occurredAt}}</view><view wx:if="{{item.observationStatus}}" class="muted">土壤：{{item.observationStatus === 'wet' ? '仍湿' : item.observationStatus === 'moderate' ? '适中' : item.observationStatus === 'dry' ? '偏干' : '无法判断'}}</view><view wx:if="{{item.amount !== null}}" class="muted">用量：{{item.amount}}{{item.amountUnit}}</view><view wx:if="{{item.note}}" class="muted">{{item.note}}</view><button class="small-button" data-id="{{item._id}}" bindtap="editEvent">更正</button><button class="text-button" data-id="{{item._id}}" bindtap="deleteEvent">删除错误记录</button></view></view>
  </block>
</view>
