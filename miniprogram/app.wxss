page {
  min-height: 100%;
  background: #f5f7f2;
  color: #263329;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  padding: 32rpx;
}

.card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(37, 67, 43, 0.06);
}

.title {
  font-size: 40rpx;
  font-weight: 650;
}

.muted {
  color: #778071;
  font-size: 28rpx;
  line-height: 1.6;
}

.button {
  margin-top: 24rpx;
  border-radius: 14rpx;
  background: #39734d;
  color: #ffffff;
}

.field {
  min-height: 84rpx;
  padding: 0 20rpx;
  border-bottom: 1rpx solid #e8ede6;
  font-size: 30rpx;
}

.plant-card {
  margin-top: 18rpx;
}

.plant-name {
  font-size: 34rpx;
  font-weight: 600;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.small-button,
.secondary-button {
  margin: 0;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: #edf3ed;
  color: #39734d;
  font-size: 26rpx;
  line-height: 68rpx;
}

.danger-button {
  background: #fbefed;
  color: #a33f35;
}

.secondary-button {
  margin-top: 12rpx;
}

.task-date {
  margin-top: 10rpx;
  color: #39734d;
  font-size: 28rpx;
}

.task-card {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e8ede6;
}

.task-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.task-actions button {
  flex: 1;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 12rpx;
  background: #edf3ed;
  color: #39734d;
  font-size: 26rpx;
}
